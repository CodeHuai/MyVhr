<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.myhr.mapper.MenuMapper">
    <resultMap id="BaseResultMap" type="com.myhr.model.Menu">
        <id column="id" property="id" jdbcType="INTEGER"></id>
        <result column="url" property="url" jdbcType="VARCHAR"></result>
        <result column="path" property="path" jdbcType="VARCHAR"></result>
        <result column="component" property="component" jdbcType="VARCHAR"></result>
        <result column="name" property="name" jdbcType="VARCHAR"></result>
        <result column="iconCls" property="iconCls" jdbcType="VARCHAR"></result>
        <result column="parentId" property="parentId" jdbcType="BIGINT"></result>
        <result column="enabled" property="enabled" jdbcType="BIT"></result>
        <association property="meta" javaType="com.myhr.model.Meta">
            <result column="keepAlive" property="keepAlive" jdbcType="BIT"></result>
            <result column="requireAuth" property="requireAuth" jdbcType="BIT"></result>
        </association>
    </resultMap>

    <resultMap id="Menus2" type="com.myhr.model.Menu" extends="BaseResultMap">
        <collection property="children" ofType="com.myhr.model.Menu">
            <id column="id2" property="id" jdbcType="INTEGER"></id>
            <result column="url2" property="url" jdbcType="VARCHAR"></result>
            <result column="path2" property="path" jdbcType="VARCHAR"></result>
            <result column="component2" property="component" jdbcType="VARCHAR"></result>
            <result column="name2" property="name" jdbcType="VARCHAR"></result>
            <result column="iconCls2" property="iconCls" jdbcType="VARCHAR"></result>
            <result column="parentId2" property="parentId" jdbcType="BIGINT"></result>
            <result column="enabled2" property="enabled" jdbcType="BIT"></result>
            <association property="meta" javaType="com.myhr.model.Meta">
                <result column="keepAlive2" property="keepAlive" jdbcType="BIT"></result>
                <result column="requireAuth2" property="requireAuth" jdbcType="BIT"></result>
            </association>
        </collection>
    </resultMap>


    <select id="getMenusByHrId" resultMap="Menus2" parameterType="Long">
        select distinct m1.*,
                        m2.id          as id2,
                        m2.parentId    as parentId2,
                        m2.name        as name2,
                        m2.path        as path2,
                        m2.url         as url2,
                        m2.component   as component2,
                        m2.enabled     as enabled2,
                        m2.iconCls     as iconCls2,
                        m2.keepAlive   as keepAlive2,
                        m2.requireAuth as requireAuth2
        from menu as m1,
             menu as m2,
             hr_role as hrr,
             menu_role as mr
        where m1.id = m2.parentId
          and hrr.hrid = #{hrid}
          and hrr.rid = mr.rid
          and mr.mid = m2.id
          and m2.enabled = true
        order by m1.id, m2.id;
    </select>
</mapper>