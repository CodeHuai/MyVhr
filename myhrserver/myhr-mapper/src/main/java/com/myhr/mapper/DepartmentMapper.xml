<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.myhr.model.Department">
    <resultMap id="BaseResultMap" type="com.myhr.model.Department">
        <id column="id" property="id" jdbcType="BIT"></id>
        <result property="name" column="name" jdbcType="VARCHAR"></result>
        <result property="parentId" column="parentId" jdbcType="BIT"></result>
        <result property="depPath" column="depPath" jdbcType="VARCHAR"></result>
        <result column="enabled" property="enabled" jdbcType="CHAR"></result>
        <result column="isParent" property="isParent" jdbcType="CHAR"></result>
    </resultMap>

    <resultMap id="DepartmentWithChildren" type="com.myhr.model.Department" extends="BaseResultMap">
        <collection property="children" ofType="com.myhr.model.Department" column="id"
                    select="com.myhr.mapper.DepartmentMapper.getAllDepartmentsByParentId"></collection>
    </resultMap>

    <select id="getAllDepartmentsByParentId" resultMap="DepartmentWithChildren">
        select *
        from department
        where parentId = #{pid};
    </select>

    <insert id="addDep" parameterType="com.myhr.model.Department">
        insert into department
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">
                name,
            </if>

        </trim>
    </insert>
</mapper>